{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31556952, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/stories", "destination": "/index.html" },
    { "source": "/stories/:path*", "destination": "/index.html" },
    { "source": "/services", "destination": "/index.html" },
    { "source": "/services/", "destination": "/index.html" },
    { "source": "/portfolio", "destination": "/index.html" },
    { "source": "/portfolio/", "destination": "/index.html" },
    { "source": "/work", "destination": "/index.html" },
    { "source": "/work/", "destination": "/index.html" },
    { "source": "/process", "destination": "/index.html" },
    { "source": "/process/", "destination": "/index.html" },
    { "source": "/inquire", "destination": "/index.html" },
    { "source": "/inquire/", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/about/", "destination": "/index.html" }
  ]
}
