{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31556952, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/archive-media",
      "schedule": "0 0 1 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/sbcs-work",
      "destination": "/api/sbcs?handler=work"
    },
    {
      "source": "/api/sbcs-work/",
      "destination": "/api/sbcs?handler=work"
    },
    {
      "source": "/admin/sbcs",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/sbcs/",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/sbcs/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/harvey",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/harvey/",
      "destination": "/admin.html"
    },
    {
      "source": "/resources",
      "destination": "/index.html"
    },
    {
      "source": "/resources/",
      "destination": "/index.html"
    },
    {
      "source": "/resources/checkout",
      "destination": "/index.html"
    },
    {
      "source": "/resources/checkout/",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/blog",
      "destination": "/admin.html"
    },
    {
      "source": "/stories",
      "destination": "/index.html"
    },
    {
      "source": "/stories/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/services",
      "destination": "/index.html"
    },
    {
      "source": "/services/",
      "destination": "/index.html"
    },
    {
      "source": "/services/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/portfolio",
      "destination": "/index.html"
    },
    {
      "source": "/portfolio/",
      "destination": "/index.html"
    },
    {
      "source": "/work",
      "destination": "/index.html"
    },
    {
      "source": "/work/",
      "destination": "/index.html"
    },
    {
      "source": "/process",
      "destination": "/index.html"
    },
    {
      "source": "/process/",
      "destination": "/index.html"
    },
    {
      "source": "/inquire",
      "destination": "/index.html"
    },
    {
      "source": "/inquire/",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/about/",
      "destination": "/index.html"
    }
  ]
}
